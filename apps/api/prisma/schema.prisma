generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum NotificationType {
  RENEWAL
  BIRTHDAY
  SYSTEM
  SUGGESTION
}

enum Sex {
  MALE
  FEMALE
}

enum AttendanceType {
  MEMBER
  VISITOR
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  member       MemberProfile?
  notifications Notification[]
  auditLogs    AuditLog[]     @relation("AuditActor")
  attendancesRecorded Attendance[] @relation("AttendanceRecorder")
}

model MembershipPlan {
  id           String          @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal         @db.Decimal(10, 2)
  description  String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      MemberProfile[]
}

model MemberProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  dateOfBirth      DateTime?
  emergencyContact String?
  photoUrl         String?
  heightCm         Float?
  sex              Sex?
  status           MembershipStatus @default(ACTIVE)
  planId           String?
  plan             MembershipPlan?  @relation(fields: [planId], references: [id])
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  attendances      Attendance[] @relation("MemberAttendance")
  hostedGuests     Attendance[] @relation("GuestHost")
  bodyMetrics      BodyMetric[]

  @@index([status])
  @@index([endDate])
  @@index([lastName, firstName])
}

model Visitor {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String
  phone       String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]

  @@index([lastName, firstName])
  @@index([phone])
}

model Attendance {
  id               String         @id @default(cuid())
  type             AttendanceType @default(MEMBER)
  memberId         String?
  member           MemberProfile? @relation("MemberAttendance", fields: [memberId], references: [id], onDelete: Cascade)
  visitorId        String?
  visitor          Visitor?       @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  hostedByMemberId String?
  hostedByMember   MemberProfile? @relation("GuestHost", fields: [hostedByMemberId], references: [id], onDelete: SetNull)
  checkInAt        DateTime       @default(now())
  checkOutAt       DateTime?
  recordedById     String?
  recordedBy       User?          @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt        DateTime       @default(now())

  @@index([memberId, checkInAt])
  @@index([visitorId, checkInAt])
  @@index([hostedByMemberId])
  @@index([checkInAt])
}

model BodyMetric {
  id           String        @id @default(cuid())
  memberId     String
  member       MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedAt   DateTime      @default(now())
  weightKg     Float?
  bodyFatPct   Float?
  chestCm      Float?
  waistCm      Float?
  hipsCm       Float?
  armsCm       Float?
  thighsCm     Float?
  neckCm       Float?
  restingHrBpm Int?
  leanMassKg   Float?
  notes        String?
  photoUrl     String?
  createdAt    DateTime      @default(now())

  @@index([memberId, recordedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  meta      Json?
  readAt    DateTime?
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AppSettings {
  id          String   @id @default("default")
  companyName String   @default("Ironleaf Gym")
  logoUrl     String?
  faviconUrl  String?
  currency    String   @default("PHP")
  updatedAt   DateTime @updatedAt
}
